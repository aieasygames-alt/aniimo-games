{
  "name": "aniimo-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "rm -rf dist && vite build && node scripts/prerender.mjs && node scripts/build-artifact-audit.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "sync:aniimo": "node scripts/sync-official-aniimo.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check:official": "node scripts/check-official-updates.mjs",
    "check:framework": "node scripts/framework-audit.mjs",
    "check:build": "node scripts/build-artifact-audit.mjs",
    "check:links": "node scripts/internal-link-audit.mjs",
    "check:seo": "node scripts/seo-audit.mjs",
    "check:expansion": "node scripts/content-expansion-audit.mjs",
    "check:content": "node scripts/content-audit.mjs",
    "check:assets": "node scripts/asset-audit.mjs",
    "check:size": "node scripts/size-audit.mjs",
    "check:verification": "node scripts/verification-audit.mjs",
    "check:gsc-watchlist": "node scripts/gsc-watchlist-audit.mjs",
    "check:launch-readiness": "node scripts/launch-readiness-audit.mjs",
    "check:adsense": "node scripts/adsense-readiness-audit.mjs",
    "check:low-value": "node scripts/low-value-content-audit.mjs",
    "check:live": "node scripts/live-audit.mjs",
    "check:monitoring": "node scripts/monitoring-report.mjs",
    "check:webmaster": "node scripts/webmaster-readiness-audit.mjs",
    "indexing:candidates": "node scripts/indexing-candidates.mjs",
    "gsc:report": "node scripts/gsc-report.mjs",
    "gsc:auth": "node scripts/gsc-api.mjs auth",
    "gsc:api": "node scripts/gsc-api.mjs report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {}
}
